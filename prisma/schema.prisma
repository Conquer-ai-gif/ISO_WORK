generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Workspace (team container) ──────────────────────────────────────────────
model Workspace {
  id        String   @id @default(uuid())
  name      String
  ownerId   String   // Clerk userId — credits are consumed from this user
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  Member[]
  projects Project[]
  invites  Invite[]
}

enum MemberRole {
  OWNER
  EDITOR
  VIEWER
}

model Member {
  id          String     @id @default(uuid())
  workspaceId String
  userId      String     // Clerk userId
  role        MemberRole @default(EDITOR)
  joinedAt    DateTime   @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Invite {
  id          String     @id @default(uuid())
  workspaceId String
  role        MemberRole @default(EDITOR)
  token       String     @unique @default(uuid())
  createdAt   DateTime   @default(now())
  expiresAt   DateTime   // 7 days from creation
  acceptedAt  DateTime?
  acceptedBy  String?    // Clerk userId who accepted

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ── Project ─────────────────────────────────────────────────────────────────
model Project {
  id        String   @id @default(uuid())
  name      String
  userId    String   // creator — always set, even for workspace projects
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Team collaboration — null for personal projects
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  repoOwner         String?
  repoName          String?
  repoWebhookId     Int?
  repoWebhookSecret String?
  lastSyncedAt      DateTime?

  vercelProjectId String?
  vercelDeployUrl String?
  customDomain    String?

  supabaseProjectId  String?
  supabaseUrl        String?
  supabaseAnonKey    String?

  contextDocument  String?  // Brand/rules injected into every prompt
  hideBadge        Boolean  @default(false)  // Pro: hide "Built with Luno" badge
  isIndexing       Boolean  @default(false)  // true while repo files are being embedded

  // Persistent E2B sandbox — reused across all generations for this project
  sandboxId        String?

  messages      Message[]
  syncConflicts SyncConflict[]
  tasks         Task[]
  integrationConfigs IntegrationConfig[]
  chatMemories  ChatMemory[]
}

enum MessageRole {
  USER
  ASSISTANT
}

enum MessageType {
  RESULT
  ERROR
}

enum PlanStatus {
  pending
  approved
  rejected
}

model Message {
  id        String      @id @default(uuid())
  content   String
  role      MessageRole
  type      MessageType
  imageUrl  String?
  plan      String?     // JSON plan generated before code execution
  planStatus PlanStatus? // pending | approved | rejected
  requiredIntegrations String? // JSON array of provider strings e.g. ["resend","stripe_secret_key"]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fragment  Fragment?

  @@index([projectId])
  @@index([projectId, createdAt])
}

model Fragment {
  id        String   @id @default(uuid())
  messageId String   @unique
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  sandboxUrl  String
  title       String
  files       Json
  deployUrl   String?
  branchName   String?  // Git branch created for this generation e.g. isotope/add-auth-abc123
  branchMerged Boolean  @default(false) // Whether branch has been merged to main
  prUrl        String?  // GitHub PR URL created on manual push

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Credit system ────────────────────────────────────────────────────────────

enum Plan {
  free
  pro
  team
}

enum CreditEventReason {
  signup
  daily_reset
  generation
  referral
  plan_upgrade
  plan_renewal
}

model Credits {
  userId     String   @id           // Clerk userId
  balance    Int      @default(50)  // V2 billing: 1 credit = 10 units. Free plan = 5 credits = 50 units.
  plan       Plan     @default(free)
  lastReset  DateTime @default(now())
  nextReset  DateTime               // set to createdAt + 30 days on signup
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  events CreditEvent[]
}

model CreditEvent {
  id        String            @id @default(uuid())
  userId    String
  delta     Int               // positive = earned, negative = spent
  reason    CreditEventReason
  createdAt DateTime          @default(now())

  credits Credits @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model GitHubToken {
  id          String   @id @default(uuid())
  userId      String   @unique
  accessToken String   // AES-256-GCM encrypted (encryptedKey hex)
  iv          String?  // AES-256-GCM IV hex — null for legacy plaintext tokens
  login       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SyncConflict {
  id            String   @id @default(uuid())
  projectId     String
  filePath      String
  isotopeContent String
  githubContent String
  resolvedBy    String?
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ── Feedback ─────────────────────────────────────────────────────────────────

enum FeedbackType {
  general
  bug
  feature
}

enum FeedbackStatus {
  new
  reviewed
  resolved
}

model Feedback {
  id        String         @id @default(uuid())
  userId    String?        // Clerk userId — null if unauthenticated
  type      FeedbackType   @default(general)
  rating    Int?           // 1–5 star rating, optional
  message   String
  status    FeedbackStatus @default(new)
  createdAt DateTime       @default(now())

  @@index([status])
  @@index([createdAt])
}

// ── Marketplace templates ─────────────────────────────────────────────────────

model MarketplaceTemplate {
  id          String   @id @default(uuid())
  projectId   String?  // source project (nullable — official templates have no project)
  userId      String   // Clerk userId of author
  title       String
  description String
  prompt      String
  category    String
  emoji       String   @default("🚀")
  files       Json     // snapshot of generated files
  useCount    Int      @default(0)
  likeCount   Int      @default(0)
  featured    Boolean  @default(false)
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  likes       TemplateLike[]

  @@index([category])
  @@index([featured])
  @@index([useCount])
  @@index([createdAt])
}

model TemplateLike {
  id         String   @id @default(uuid())
  userId     String
  templateId String
  createdAt  DateTime @default(now())

  template MarketplaceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId])
}

// ── Referral program ─────────────────────────────────────────────────────────
model Referral {
  id          String   @id @default(uuid())
  code        String   @unique  // e.g. "abc123" — the referrer's invite code
  ownerId     String   @unique  // Clerk userId who owns this code
  createdAt   DateTime @default(now())

  uses        ReferralUse[]
}

model ReferralUse {
  id         String   @id @default(uuid())
  referralId String
  newUserId  String   @unique  // the person who signed up with the code
  createdAt  DateTime @default(now())

  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
}

// ── Changelog ─────────────────────────────────────────────────────────────────

enum ChangelogType {
  feature
  improvement
  bugfix
  breaking
}

model ChangelogEntry {
  id          String        @id @default(uuid())
  title       String
  content     String
  type        ChangelogType @default(feature)
  tags        String[]
  published   Boolean       @default(false)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([published])
  @@index([publishedAt])
}

model ChangelogSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([active])
}

// ── Generation event stream ───────────────────────────────────────────────────
// Written by the Inngest function; polled by /api/generation/stream SSE endpoint.

model GenerationEvent {
  seq       Int      @id @default(autoincrement())
  messageId String
  type      String
  taskId    String?
  data      Json?    @default("{}")
  createdAt DateTime @default(now())

  @@index([messageId])
}

// ── Task board ────────────────────────────────────────────────────────────────

enum TaskStatus {
  todo
  in_progress
  in_review
  done
}

enum TaskPriority {
  low
  medium
  high
}

model Task {
  id          String       @id @default(uuid())
  projectId   String
  title       String
  description String?
  status      TaskStatus   @default(todo)
  priority    TaskPriority @default(medium)
  labels      String[]
  order       Int          @default(0)
  createdBy   String       // Clerk userId
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

// ── Integration configs — encrypted third-party API keys per project ──────────
// Keys are encrypted (AES-256-GCM) before storage.
// They are NEVER returned as plaintext via tRPC — only masked for UI display.
// Decryption happens exclusively inside the Inngest sandbox injection step.

enum IntegrationProvider {
  resend
  supabase_url
  supabase_anon_key
  supabase_service_key
  stripe_secret_key
  stripe_publishable_key
  openrouter_api_key  // OpenRouter — AI models (platform uses this, not openai_api_key)
  openai_api_key      // OpenAI direct — for generated apps that call OpenAI API themselves
  figma_token         // User's personal Figma access token (starts with figd_)
  custom
}

model IntegrationConfig {
  id           String              @id @default(uuid())
  projectId    String
  provider     IntegrationProvider
  encryptedKey String              // AES-256-GCM ciphertext (hex)
  iv           String              // AES-256-GCM initialisation vector (hex)
  customEnvVar String?             // only populated when provider is `custom`
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, provider])
  @@index([projectId])
}

// ── Doc Cache — global library documentation cache (shared across all users) ──
// Persists Tavily + summarizer results in Postgres so every user benefits,
// even without Supabase configured. 30-day TTL. Keyed by SHA-256 hash of
// libraryName + description snippet — collision-safe across different use cases.
model DocCache {
  id          String   @id @default(uuid())
  cacheKey    String   @unique  // SHA-256 hash (32 chars) of libraryName::description
  libraryName String
  summary     String   // Summarized markdown doc (up to ~3000 chars)
  cachedAt    DateTime @default(now())
  expiresAt   DateTime           // cachedAt + 30 days — checked on read

  @@index([cacheKey])
  @@index([expiresAt])  // for future cleanup cron
}

// ── Chat Memory — project-scoped long-term semantic memory ───────────────────
// NOTE: This model is currently NOT used by the codebase.
// Memory archiving and retrieval uses Supabase pgvector via src/lib/vector-store.ts
// (archiveProjectMemory, searchProjectMemory, upsertFilesToVectorStore).
//
// This model is reserved for a future fallback when the user has NOT configured
// Supabase. Until that is built, no code reads or writes to this table.
//
// Future implementation guide:
//   1. In vector-store.ts check if supabaseUrl is configured
//   2. YES → use Supabase pgvector (current behaviour)
//   3. NO  → fall back to prisma.chatMemory (text only, no embeddings)
//   4. For search without embeddings use Prisma full-text search:
//      prisma.chatMemory.findMany({ where: { content: { contains: query } } })
// ── Chat Memory — RESERVED, NOT IN USE ───────────────────────────────────────
// This model is defined but never queried via Prisma in the current codebase.
// Project memory is stored in Supabase pgvector via archiveProjectMemory()
// and searchProjectMemory() in src/lib/vector-store.ts.
//
// This model exists as a fallback for when Supabase is not configured.
// To activate it in the future:
//   1. In vector-store.ts, detect if supabaseUrl is missing
//   2. Fall back to prisma.chatMemory.create() / findMany() instead
//   3. For semantic search without pgvector, use keyword matching on `content`
//      until a proper embedding solution is wired to Prisma.
//
// Do NOT delete — it is needed for the offline/no-Supabase memory path.
model ChatMemory {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String   // 'user' | 'assistant'
  content   String   // the text that was embedded
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, createdAt])
}

// ── Job Cache — stores Remotive jobs, refreshed every 24h ────────────────────
// Avoids hammering the Remotive API on every page visit.
// All users share the same cached jobs — no per-user data here.
model JobCache {
  id          String   @id @default(uuid())
  remoteId    String   @unique  // Remotive job ID — prevents duplicates
  title       String
  company     String
  companyLogo String?
  url         String
  category    String   // e.g. "software-dev", "design", "devops"
  tags        String[] // e.g. ["React", "TypeScript", "Next.js"]
  salaryRange String?
  jobType     String   // "full_time" | "contract" | "part_time"
  location    String?
  postedAt    DateTime
  cachedAt    DateTime @default(now())

  @@index([category])
  @@index([cachedAt])
  @@index([postedAt])  // queries always orderBy postedAt desc
}

enum PurchaseStatus {
  pending
  completed
  failed
}

// ── Credit Purchase — tracks one-time Stripe credit top-ups ─────────────────
model CreditPurchase {
  id              String         @id @default(uuid())
  userId          String
  stripeSessionId String         @unique
  credits         Int            // credits purchased (user-facing, e.g. 25)
  units           Int            // internal units (credits × 10)
  amountCents     Int            // amount paid in cents (e.g. 999 = $9.99)
  status          PurchaseStatus @default(pending)
  createdAt       DateTime       @default(now())
  completedAt     DateTime?

  @@index([userId])
  @@index([stripeSessionId])
}
